<!-- -----------------------------------------------------------
EJERCICIO 5.4 — ¿Qué hace esta query? Usa /explain
-----------------------------------------------------------

💬 INSTRUCCIÓN PARA EL CHAT:
   Selecciona la query completa de abajo y escribe en el chat:
   "/explain ¿Qué datos devuelve esta query FetchXML?
   Explica cada sección: fetch, entity, attribute, filter,
   link-entity y order"
-->
<fetch top="50" distinct="false">
  <entity name="account">
    <attribute name="name" />
    <attribute name="revenue" />
    <attribute name="numberofemployees" />
    <attribute name="industrycode" />
    <filter type="and">
      <condition attribute="statecode" operator="eq" value="0" />
      <condition attribute="revenue" operator="gt" value="1000000" />
      <condition attribute="industrycode" operator="in">
        <value>7</value>
        <value>10</value>
        <value>14</value>
      </condition>
    </filter>
    <link-entity name="contact" from="parentcustomerid" to="accountid" link-type="inner">
      <attribute name="fullname" alias="contacto_principal" />
      <attribute name="emailaddress1" alias="email_contacto" />
      <filter>
        <condition attribute="decisionmaker" operator="eq" value="1" />
      </filter>
    </link-entity>
    <order attribute="revenue" descending="true" />
  </entity>
</fetch>


<!-- -----------------------------------------------------------
EJERCICIO 5.5 — Optimización y errores comunes
-----------------------------------------------------------

💬 INSTRUCCIÓN PARA EL CHAT:
   Selecciona la query de abajo y escribe:
   "/fix Esta query FetchXML tarda mucho en ejecutarse.
   ¿Puedes identificar problemas de rendimiento y sugerir mejoras?
   También comprueba si hay errores de sintaxis."
-->
<fetch>
  <entity name="contact">
    <all-attributes/>
    <link-entity name="account" from="accountid" to="parentcustomerid" link-type="outer">
      <all-attributes/>
      <link-entity name="opportunity" from="customerid" to="accountid" link-type="outer">
        <all-attributes/>
        <link-entity name="systemuser" from="systemuserid" to="ownerid" link-type="outer">
          <all-attributes/>
        </link-entity>
      </link-entity>
    </link-entity>
  </entity>
</fetch>


